APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_BASE_URL=https://example.com

SESSION_SECRET=replace_with_production_session_secret
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_LIFETIME=7200

DB_HOST=replace_with_production_db_host
DB_PORT=3306
DB_DATABASE=replace_with_production_db_name
DB_USERNAME=replace_with_production_db_user
DB_USER=replace_with_production_db_user
DB_PASSWORD=replace_with_production_db_password
DB_NAME=replace_with_production_db_name
DB_CHARSET=utf8mb4

UPLOAD_DIR=uploads

BAKERY_NAME=Cakeouflage
BAKERY_TAGLINE=We bake sweet wonderful happy memories
BAKERY_CITY=Your City
BAKERY_LAT=0
BAKERY_LNG=0
BAKERY_SERVICE_RADIUS_KM=30

WHATSAPP_NUMBER=
SUPPORT_PHONE=
SUPPORT_EMAIL=

SMTP_HOST=replace_with_production_smtp_host
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=replace_with_production_smtp_user
SMTP_PASS=replace_with_production_smtp_password
SMTP_FROM_NAME=Cakeouflage
SMTP_FROM_EMAIL=replace_with_production_smtp_from_email

QUEUE_CRON_TOKEN=replace_with_production_queue_cron_token
SEED_WEB_TOKEN=replace_with_production_seed_web_token
DEPLOY_MIGRATE_TOKEN=replace_with_production_deploy_migrate_token

FTP_HOST=replace_with_production_ftp_host
FTP_USER=replace_with_production_ftp_user
FTP_PASS=replace_with_production_ftp_password